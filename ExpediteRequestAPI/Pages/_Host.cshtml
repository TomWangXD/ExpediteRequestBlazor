@page "/"
@namespace ExpediteRequestAPI.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Hosting
@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Expedite Request</title>
    <base href="~/" />

    @* Load the Indium theme based on the current environment *@
    @if (Env.IsEnvironment("Production"))
    {
        <link href="css/Indium_Light/bootstrap-prod.css" rel="stylesheet" />
    }
    else if (Env.IsEnvironment("Testing"))
    {
        <link href="css/Indium_Light/bootstrap-test.css" rel="stylesheet" />
    }
    else if (Env.IsEnvironment("Development"))
    {
        <link href="css/Indium_Light/bootstrap-dev.css" rel="stylesheet" />
    }
    else
    {
        <link href="css/Indium_Light/bootstrap-other.css" rel="stylesheet" />
    }

    <link href="css/site.css" rel="stylesheet" />
    <link href="ExpediteRequestAPI.styles.css" rel="stylesheet" />

    <link href="_content/DevExpress.Blazor.Themes/bootstrap-external.bs5.min.css" rel="stylesheet" />
    <link href="_content/DevExpress.Blazor.RichEdit/dx-blazor-richedit.bs5.css" rel="stylesheet" asp-append-version="true" />

    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <link href="fonts/stylesheet.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
</head>
<body>
    <app>
        <component type="typeof(App)" render-mode="ServerPrerendered" />
    </app>
    <script src="_framework/blazor.server.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>
