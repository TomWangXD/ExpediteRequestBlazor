@using DevExpress.Blazor

@using Indium.Common.DataTransferObjects
@using Indium.Common.Models
@using Indium.Components
@using Indium.Components.Layout
@using Indium.Components.Assets
@using Microsoft.AspNetCore.Hosting
@using MudBlazor;

@inherits LayoutComponentBase

@inject IWebHostEnvironment Env
@inject NavigationManager NavigationManager
@inject Indium.Common.EFContexts.CommonContext context
@inject Microsoft.Extensions.Configuration.IConfiguration _config

<IndiumThemeProvider DarkMode="false" IncludeTypography="true" />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="MainLayout">
    <MudLayout>
        <Header Title="Expedite Request" TabList="@Items" AssumeVisibility=true />
        <MudMainContent Class="page">
            @Body
        </MudMainContent>
        <Footer ApplicationID=@AppId />
    </MudLayout>
    <TrafficCount TrafficCountUri="@TrafficCountUri" />
</div>

@code {
    [CascadingParameter]
    public LoginModel AdInfo { get; set; } = null!;

#pragma warning disable
    //TODO: These are going need to be removed at somepoint. Keeping them here for ease of navigation while developing
    List<DxMenuDataMapping> Items = new();
#pragma warning restore

    private int? AppId = null;

    string TrafficCountUri = "";

    bool IsMobileLayout { get; set; }

    private List<PermissionDropdown> permissionList = new List<PermissionDropdown>();
    private List<string> OwnerList = new List<string>();
    private LoginModel loginModel = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (NavigationManager.BaseUri.Contains("ica.com"))
        {
            string tempUri = _config["APIs:TrafficCount"] ?? "";
            if (!string.IsNullOrWhiteSpace(tempUri))
            {
                TrafficCountUri = _config["APIs:TrafficCount"] + "/ExpediteRequestBlazor";
            }
        }
        string AppName = _config["ApplicationTitle"] ?? "";
        if (!string.IsNullOrWhiteSpace(AppName))
        {
            AppId = context.CmApplicationMasters.Where(app => app.DisplayName == AppName).Select(app => app.Id).FirstOrDefault();
            AppId = AppId == 0 ? null : AppId;
        }

        Items = GetItems();

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    async void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (IsMobileLayout)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public List<DxMenuDataMapping> GetItems()
    {
        #pragma warning disable
        return new() {
            new() {
                Key = "0",
                Name = "ExpediteRequests",
                Text = "Expedite Requests",
                NavigateUrl = "ExpediteRequests"
            },
            new()
            {
                Key = "1",
                Name =  "ExpediteForm",
                Text = "Expedite Form",
                NavigateUrl = "ExpediteForm"
            },
            new()
            {
                Key = "2",
                Name = "ProductionPlanner",
                Text = "Production Planner",
                NavigateUrl = "ProductionPlanner",
            }
        };
        #pragma warning restore
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

