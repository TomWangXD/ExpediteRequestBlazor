@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

@inject IDocumentService requestService
@inject IDropdownService dropdownService
@inject IExpediteRequestService expediteRequestService
@inject ILogger<Form> logger
@inject ISnackbar snackbar
@inject User user
@inject NavigationManager navigationManager

<MudText Align="Align.Center" Class="fw-bold" Typo="Typo.h2">Expedite Form</MudText>

<div class="container">
    <div class="col mt-4">
        <EditForm Context="formContext" @key="Request" Model="Request">
            <DataAnnotationsValidator/>
            <DxFormLayout  SizeMode="SizeMode.Large" CaptionPosition="CaptionPosition.Vertical">
                <DxFormLayoutItem Caption="Order Number" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxTextBox 
                    Text="@CoNum" 
                    TextChanged="@(async(value) => {
                        Request.CoNum = value;
                        await GetLines(value);
                    })"
                    TextExpression="@(() => Request.CoNum)"
                    ReadOnly=!isNewForm/> 

                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Line" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxComboBox 
                    Value=Request.CoLine
                    ValueChanged="(async(value) => {
                        Request.CoLine = value;
                        await GetReleases();
                    })"
                    ValueExpression="(() => Request.CoLine)"
                    Data="coLines"
                    TData="short" 
                    TValue="short"
                    ReadOnly=!isNewForm
                    SizeMode="SizeMode.Large"/>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Release" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxComboBox Value=Request.CoRelease
                    ValueChanged="(async(value) => {
                                    Request.CoRelease = value;
                                    await GetSytelineRequest();

                                })"
                    ValueExpression="(() => Request.CoRelease)"
                    Data="coReleases"
                    TData="short"
                    TValue="short"
                    ReadOnly=!isNewForm
                    SizeMode="SizeMode.Large" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Ship Site" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxTextBox @bind-Text="Request.ShipSite"
                    SizeMode="SizeMode.Large"
                    ReadOnly=true />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Job Number" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxTextBox @bind-Text="Request.Job"
                    SizeMode="SizeMode.Large"
                    ReadOnly=true />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Ipn" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxTextBox @bind-Text="Request.Ipn"
                    SizeMode="SizeMode.Large"
                    ReadOnly=true />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="IPN Description" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxTextBox @bind-Text="Request.IpnDescription"
                    SizeMode="SizeMode.Large"
                    ReadOnly=true />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Order Date" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxDateEdit @bind-Date="Request.OrderDate"
                    SizeMode="SizeMode.Large"
                    ReadOnly=true />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Customer Name" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxTextBox @bind-Text="Request.CustomerName"
                    SizeMode="SizeMode.Large"
                    ReadOnly=true />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Qty Ordered" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxSpinEdit @bind-Value="Request.QtyOrdered"
                    SizeMode="SizeMode.Large"
                    ReadOnly=true />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="UOM" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxTextBox @bind-Text="Request.Um"
                    SizeMode="SizeMode.Large"
                    ReadOnly=true />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Due Date"ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxDateEdit @bind-Date="Request.DueDate"
                    SizeMode="SizeMode.Large"
                    ReadOnly=true />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Planner Code" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxTextBox @bind-Text="Request.PlanCode"
                    SizeMode="SizeMode.Large"
                    ReadOnly=true />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Partial Quantity Accepted" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxCheckBox @bind-Checked="Request.PartialQuantityAccepted"
                    SizeMode="SizeMode.Large"
                    ReadOnly=false />
                </DxFormLayoutItem>
                @if (Request.PartialQuantityAccepted)
                {
                    <DxFormLayoutItem Caption="Partial Quantity" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                        <DxSpinEdit @bind-Value="Request.PartialQuantity"
                        SizeMode="SizeMode.Large"
                        ReadOnly=false/>
                    </DxFormLayoutItem>
                }
                @if(Request.Id != 0)
                {
                    <DxFormLayoutItem Caption="DPAs" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                        <DxCheckBox @bind-Checked="Request.Dpas"
                        SizeMode="SizeMode.Large"
                        ReadOnly=false />
                    </DxFormLayoutItem>
                }
                <DxFormLayoutItem Caption="Fee" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxCheckBox @bind-Checked="Request.Fee"
                    SizeMode="SizeMode.Large"
                    ReadOnly=false />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Request Ship Date" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxDateEdit @bind-Date="Request.ShipDate"
                    SizeMode="SizeMode.Large"
                    ReadOnly=false
                    />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Reasons" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxComboBox @bind-Value=Request.Reason
                    Data="@reasons"
                    TData="string"
                    TValue="string"
                    ReadOnly=false
                    SizeMode="SizeMode.Large" />
                    <ValidationMessage For="@(() => Request.Reason)"/>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Expedite Status" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                    <DxComboBox @bind-Value=Request.Status
                    Data="statuses"
                    TData="string"
                    TValue="string"
                    ReadOnly=true
                    SizeMode="SizeMode.Large" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Comments" ColSpanSm="12" ColSpanMd="12" ColSpanLg="12" ColSpanXl="12" ColSpanXxl="12">
                    <DxMemo @bind-Text="Request.Comments"
                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                    NullText=""
                    SizeMode="SizeMode.Large"
                    Rows="5"
                    ReadOnly=!isNewForm />
                </DxFormLayoutItem>

                @if (Request.Id != 0)
                {
                    <DxFormLayoutItem Caption="Approver" ColSpanSm="6" ColSpanMd="6" ColSpanLg="6" ColSpanXl="6" ColSpanXxl="6">
                        <DxTextBox 
                        Text="@Approver"
                        SizeMode="SizeMode.Large"
                        ReadOnly=true/>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Approval Status" ColSpanSm="6" ColSpanMd="6" ColSpanLg="6" ColSpanXl="6" ColSpanXxl="6">
                        <DxComboBox @bind-Value="@ApprovalStatus"
                        Data="approvalStatuses"
                        SizeMode="SizeMode.Large"
                        ReadOnly=false />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Approver Comments" ColSpanSm="12" ColSpanMd="12" ColSpanLg="12" ColSpanXl="12" ColSpanXxl="12">
                        <DxMemo @bind-Text="@ApproverComments"
                        SizeMode="SizeMode.Large"
                        ReadOnly=false
                        Rows="4"/>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4" />
                    <DxFormLayoutItem ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4" />

                    <DxFormLayoutItem Caption="Created Date" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                        <DxDateEdit @bind-Date="Request.Created"
                        SizeMode="SizeMode.Large"
                        ReadOnly=true />
                    </DxFormLayoutItem>
                }

                @if(Request.Id == 0)
                {
                    <DxFormLayoutItem CssClass="mb-5" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                        <DxButton Context="buttonCancel" Click="@(() => Cancel())" SizeMode="SizeMode.Large">Cancel</DxButton>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem CssClass="mb-5" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                        <DxButton Context="buttonSave" Click="@(() => Save())" SizeMode="SizeMode.Large">Save</DxButton>
                    </DxFormLayoutItem>
                }
                else
                {
                    <DxFormLayoutItem CssClass="mb-5" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                        <DxButton Context="buttonApprove" Click="@(() => Save("Approved"))" SizeMode="SizeMode.Large">Approve</DxButton>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem CssClass="mb-5" ColSpanSm="6" ColSpanMd="6" ColSpanLg="4" ColSpanXl="4" ColSpanXxl="4">
                        <DxButton Context="buttonDecline" Click="@(() => Save("Declined"))" SizeMode="SizeMode.Large">Decline</DxButton>
                    </DxFormLayoutItem>
                }
            </DxFormLayout>
        </EditForm>
    </div>
</div>

@code {
    #nullable enable
    // public Guid? Gkey { get; set; }
    [Parameter]
    public Document? Request { get; set; } = new();

    #nullable disable

    private List<short> coLines = new();
    private List<short> coReleases = new();
    private List<string> reasons = new();
    private List<string> statuses = new();
    private List<string> approvalStatuses = new();
    private string CoNum = string.Empty;
    private bool isNewForm = false;

    private string Approver
    {
        get
        {
            if (Request.Approvals is not null && Request.Id != 0)
            {
                if (Request.Approvals.Count > 0)
                {
                    if (string.IsNullOrEmpty(_approver))
                    {
                        return user.Employee.FullName;
                    }
                    return Request.Approvals.ToList()[0].Signature;
                }
                else
                {
                    return user.Employee.SamaccountName;
                }
            }
            return string.Empty;
        }
        set
        {

        }
    }
    private string _approver;


    private string ApprovalStatus
    {
        get
        {
            if (Request.Approvals is not null && Request.Approvals.Count > 0)
            {
                return _approvalStatus;
            }
            return string.Empty;
        }
        set
        {
            if (!string.IsNullOrEmpty(value))
            {
                _approvalStatus = value;
                Request.Status = value;
            }
        }
    }
    private string _approvalStatus;

    private string ApproverComments
    {
        get
        {
            if (Request.Approvals is not null && Request.Approvals.Count > 0)
            {
                return _approverComments;
            }
            return string.Empty;
        }
        set
        {
            _approverComments = value ?? string.Empty;
            Request.ApproverComments = _approverComments;
        }
    }
    private string _approverComments;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            reasons = await dropdownService.GetExpediteReasons();
            approvalStatuses = await dropdownService.GetApprovalStatuses();
        }
        catch (Exception ex)
        {
            logger.LogError($"Expedite Reasons could not be fetched: {ex}");
            snackbar.Add("Could not retrieve expedite requests", Severity.Error);
        }
    }

    protected override void OnParametersSet()
    {
        if (Request is null)
        {
            Request = new();
            Request.ShipDate = DateTime.UtcNow;
            isNewForm = true;
        }
        else
        {
            SetApprovals();
        }
        CoNum = Request.CoNum;
    }

    private async Task Save(string response = "")
    {
        try
        {
            snackbar.Add("Saving...", Severity.Info);

            if (!string.IsNullOrEmpty(response))
            {
                Request.Status = response;
            }
            await requestService.HandleObject(Request);

            snackbar.Add("Saved!", Severity.Success);
            NavigateToHome();
        }
        catch (Exception ex)
        {
            snackbar.Add("There was an error saving the request", Severity.Error);
            logger.LogError($"Error saving Request.\n\nOrder Number: {Request.CoNum}\nLines: {Request.CoLine}\nReleases: {Request.CoRelease}\n{ex}");
        }
    }

    private void Cancel() => NavigateToHome();

    private async Task GetReleases()
    {
        try
        {
            coReleases = await expediteRequestService.GetOrderReleases(Request.CoNum, Request.CoLine);
            if (coReleases.Count == 1 && coReleases[0] == 0)
            {
                await GetSytelineRequest();
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"There was an error retrieving releases: Order Number: {Request.CoNum}, Line: {Request.CoLine} {ex}");
        }
    }

    private async Task GetSytelineRequest()
    {
        try
        {
            var sytelineData = await expediteRequestService.GetSytelineDocumentDataAsync(Request.CoNum, Request.CoLine, Request.CoRelease);
            if (sytelineData is not null)
            {
                Request = new Document(Request, sytelineData);
                CoNum = Request.CoNum;
            }
        }
        catch (Exception ex)
        {
            logger.LogError($"There was an error retrieving syteline Request: {ex}");
        }
    }

    private async Task GetLines(string coNum)
    {
        try
        {
            snackbar.Add("Loading lines...", Severity.Info);
            coLines = await expediteRequestService.GetOrderLines(coNum);
            if (coLines?.Count == 0)
            {
                snackbar.Add("Could not retrieve lines", Severity.Info);
            }
            else
            {
                snackbar.Add("Lines retrieved!", Severity.Success);
        
            }
        }
        catch (Exception ex)
        {
            snackbar.Add("There was an error retrieving the lines", Severity.Error);
            logger.LogError($"There was an error retrieving the lines. Order Number: {coNum}. {ex}");
        }
    }

    private void SetApprovals()
    {
        if (Request.Approvals?.Count > 0)
        {
            ApproverComments = Request.Approvals.ToList()[0].Remarks;
            ApprovalStatus = Request.Approvals.ToList()[0].ApprovalStatus;
        }
    }

    private void NavigateToHome() => navigationManager.NavigateTo("/");
}
