@using DevExpress.Blazor;
@using DevExpress.Data.Async.Helpers;
@using DevExpress.Data.Linq;
@using ExpediteRequestBlazor.DataTransferObjects;
@using ExpediteRequestBlazor.EFModels.ViewModels
@using ExpediteRequestBlazor.Modules.Services.Interfaces
@using Microsoft.EntityFrameworkCore
@using MudBlazor

@inject ILogger<ExpediteRequestsTable> logger
@inject NavigationManager navigationManager
@inject IDocumentService documentService
@inject IJSRuntime jsRuntime
@inject ISnackbar snackbar

@implements IDisposable

<MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mb-2" OnClick="ToggleExportPopup">Export</MudButton>

<DxGrid Data="_instantFeedbackSource"
@ref=@Grid
ShowFilterRow=true
PagerNavigationMode="PagerNavigationMode.Auto"
SizeMode="SizeMode.Medium"
PageSize="10"
CssClass="mt-5"
PageSizeSelectorVisible=true
PageSizeSelectorItems=@(new int[] { 10, 20, 50, 100 })
PagerVisibleNumericButtonCount=10
ColumnResizeMode=GridColumnResizeMode.ColumnsContainer
SelectionMode=GridSelectionMode.Single
AllowSelectRowByClick=true
SelectedDataItemChanged=@(selected => ViewForm(selected))>

    <Columns>
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Status)" Caption="Expedite Status" MinWidth="100">
            <FilterRowCellTemplate>
                <DxComboBox TData="string"
                            TValue="string"
                            Data="expediteStatus"
                            AllowUserInput="false"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                            NullText="All Status"
                            Value="@_selectedExpediteStatus"
                            ValueChanged="OnExpediteStatusFilterChanged" />
            </FilterRowCellTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.InProgress)" Caption="In Progress" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.CreatedBy)" Caption="Created By" MinWidth="220" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.CoNum)" Caption="Order Number" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.CoLine)" Caption="Line" MinWidth="70" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.CoRelease)" Caption="Release" MinWidth="70" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.PlanCode)" Caption="Planner Code" MinWidth="100">
            <FilterRowCellTemplate>
                <DxComboBox TData="string"
                            TValue="string"
                            Data="plannerCode"
                            AllowUserInput="false"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                            NullText="All Planner Code"
                            Value="@_selectedPlannerCode"
                            ValueChanged="OnPlannerCodeFilterChanged" />
            </FilterRowCellTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.ShipSite)" Caption="Ship Site" MinWidth="100">
            <FilterRowCellTemplate>
                <DxComboBox TData="string"
                            TValue="string"
                            Data="sites"
                            AllowUserInput="false"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                            NullText="All Sites"
                            Value="@_selectedShipSite"
                            ValueChanged="OnShipSiteFilterChanged" />
            </FilterRowCellTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Job)" Caption="Job Number" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Ipn)" Caption="IPN" MinWidth="200" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.IpnDescription)" Caption="IPN Description" MinWidth="200" />

        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.OrderDate)" Caption="Order Date" MinWidth="100" DisplayFormat="d" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.CustomerName)" Caption="Customer Name" MinWidth="130" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.QtyOrdered)" Caption="Quantity" MinWidth="70" DisplayFormat="N0" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Um)" Caption="UOM" MinWidth="70" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.DueDate)" Caption="Due Date" MinWidth="100" DisplayFormat="d" />

        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.ShelfLifeRequirement)" Caption="Shelf Life Required" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.PonderosaPack)" Caption="Ponderosa Pack" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.CurrentDueDate)" Caption="Current Due Date" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.PartialQuantityAccepted)" Caption="Partial Accepted" MinWidth="100" />

        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.PartialQuantity)" Caption="Partial Quantity" MinWidth="70" DisplayFormat="N0" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.ShipDate)" Caption="Request Ship Date" MinWidth="100" DisplayFormat="d" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Fee)" Caption="Expedite Fee" MinWidth="70" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Reason)" Caption="Reason for Expedite" MinWidth="150" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Comments)" Caption="Comments" MinWidth="300" />

        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Approver)" Caption="Approver" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.ApprovalStatus)" Caption="Approve Status" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.ApprovalRemarks)" Caption="Approver Comments" MinWidth="150" /> 

        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.NewShipDate)" Caption="New Ship Date" MinWidth="90" DisplayFormat="d" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Created)" SortIndex="0" SortOrder="GridColumnSortOrder.Descending" Caption="Created Date" MinWidth="90" DisplayFormat="g" />
    </Columns>

</DxGrid>

<DxPopup Visible="@displayExportPopup"

HeaderText="Please select a date range"
CloseOnOutsideClick="false">
    <BodyContentTemplate Context="popupCtx">
        <div class="mb-5 mt-5">
            <DateRangeFilterExportTemplate @bind-DateRange="ExportDateRangeFilter" />
        </div>
        <div class="modal-button">
            <DxButton SizeMode="SizeMode.Medium" Visible="!isExporting" Click="@(async() => await ExportByDate(ExportDateRangeFilter))">Export by Date</DxButton>
            <DxButton SizeMode="SizeMode.Medium" Visible="!isExporting" Click="@(async() => await ExportAll())">Export all</DxButton>
            <DxButton SizeMode="SizeMode.Medium" Visible="!isExporting" Click="ToggleExportPopup">Cancel</DxButton>
        </div>
    </BodyContentTemplate>
</DxPopup> 


@code {
    private EntityInstantFeedbackSource _instantFeedbackSource = null!;
    private IGrid Grid { get; set; }
    private List<string> sites = new();
    private List<string> expediteStatus = new();
    private List<string> plannerCode = new();
    private string? _selectedShipSite;
    private string? _selectedExpediteStatus;
    private string? _selectedPlannerCode;

    private DateRange ExportDateRangeFilter { get; set; } = GetDefaultDateRange();

    private bool displayExportPopup = false;
    private bool isLoaded = false;
    private bool isExporting = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (isLoaded)
            {
                return;
            }

            ConfigureInstantFeedbackSource();
            sites = await documentService.GetAll_SitesFromRequests();
            expediteStatus = await documentService.GetAll_ExpediteStatusFromRequests();
            plannerCode = await documentService.GetAll_PlannerCodeFromRequests();

            isLoaded = true;
        }
        catch (Exception ex)
        {
            logger.LogError(ex.ToString());
        }
    }

    private void ConfigureInstantFeedbackSource()
    {
        IQueryable<ExpediteRequestsExtended> query = documentService.GetAll();

        if (!string.IsNullOrWhiteSpace(_selectedShipSite))
        {
            query = query.Where(request => request.ShipSite == _selectedShipSite);
        }

        if (!string.IsNullOrWhiteSpace(_selectedExpediteStatus))
        {
            query = query.Where(request => request.Status == _selectedExpediteStatus);
        }
        if (!string.IsNullOrWhiteSpace(_selectedPlannerCode))
        {
            query = query.Where(request => request.PlanCode == _selectedPlannerCode);
        }


        ReplaceInstantFeedbackSource(query);
    }

    private void ReplaceInstantFeedbackSource(IQueryable<ExpediteRequestsExtended> query)
    {
        EntityInstantFeedbackSource? previousSource = _instantFeedbackSource;

        _instantFeedbackSource = new(options =>
        {
            options.KeyExpression = nameof(ExpediteRequestsExtended.Id);
            options.QueryableSource = query;
        });

        previousSource?.Dispose();
    }

    private async Task OnShipSiteFilterChanged(string? shipSite)
    {
        _selectedShipSite = string.IsNullOrWhiteSpace(shipSite) ? null : shipSite;

        ConfigureInstantFeedbackSource();
        await InvokeAsync(StateHasChanged);
    }
    private async Task OnExpediteStatusFilterChanged(string? expediteStatus)
    {
        _selectedExpediteStatus = string.IsNullOrWhiteSpace(expediteStatus) ? null : expediteStatus;

        ConfigureInstantFeedbackSource();
        await InvokeAsync(StateHasChanged);
    }
    private async Task OnPlannerCodeFilterChanged(string? plannerCode)
    {
        _selectedPlannerCode = string.IsNullOrWhiteSpace(plannerCode) ? null : plannerCode;

        ConfigureInstantFeedbackSource();
        await InvokeAsync(StateHasChanged);
    }

    private void ViewForm(object proxyObject)
    {
        var proxy = proxyObject as ReadonlyThreadSafeProxyForObjectFromAnotherThread;
        var row = proxy?.OriginalRow as ExpediteRequestsExtended;

        if (row is not null) navigationManager.NavigateTo($"ExpediteForm/{row.Gkey.ToString()}");
    }

    private void ToggleExportPopup()
    {
        displayExportPopup = !displayExportPopup;
        ExportDateRangeFilter = GetDefaultDateRange();
    }

    private static DateRange GetDefaultDateRange() => new DateRange() { Start = DateTime.UtcNow.AddDays(-14), End = DateTime.UtcNow };

    private async Task ExportAll()
    {
        try
        {
            ToggleExportPopup();
            isExporting = true;
            snackbar.Add("Exporting all...", Severity.Info);
            List<ExpediteRequestsExtended> RowsToExport = new();
            RowsToExport = await documentService.GetAll_Export();
            await documentService.DownloadExcelFile(RowsToExport, jsRuntime, logger);
            snackbar.Add("All data exported!", Severity.Success);
        }
        catch(Exception ex)
        {
            logger.LogError($"Error exporting all:{ex.ToString()}");
            snackbar.Add("There was an error exporting all", Severity.Error);
        }
    }

    public async Task ExportByDate(DateRange? dateRange)
    {
        try
        {
            ToggleExportPopup();
            snackbar.Add("Exporting...", Severity.Info);
            List<ExpediteRequestsExtended> RowsToExport = dateRange is not null ?
                                               await documentService.GetAll_Export(dateRange) :
                                               await documentService.GetAll_Export();

            await documentService.DownloadExcelFile(RowsToExport, jsRuntime, logger);

            snackbar.Add(
                dateRange is not null && dateRange.Start != null && dateRange.End != null
                    ? $"Data exported for {dateRange.Start:MM/dd/yyyy} - {dateRange.End:MM/dd/yyyy}"
                    : "Data exported!",
                Severity.Success
            );
        }
        catch(Exception ex)
        {
            logger.LogError($"Error exporting all:{ex.ToString()}");
            snackbar.Add("There was an error exporting all", Severity.Error);
        }
    }

    public void Dispose() => _instantFeedbackSource?.Dispose();
}
