@using DevExpress.Blazor;
@using DevExpress.Data.Async.Helpers;
@using DevExpress.Data.Linq;
@using ExpediteRequestBlazor.DataTransferObjects;
@using ExpediteRequestBlazor.EFModels.ViewModels
@using ExpediteRequestBlazor.Modules.Services.Interfaces
@using Microsoft.EntityFrameworkCore

@inject ILogger<ExpediteRequestsTable> logger
@inject NavigationManager navigationManager
@inject IDocumentService documentService

@implements IDisposable

<DxGrid Data="_instantFeedbackSource"
ShowFilterRow=true
PagerNavigationMode="PagerNavigationMode.Auto"
SizeMode="SizeMode.Medium"
PageSize="10"
PageSizeSelectorVisible=true
PageSizeSelectorItems=@(new int[] { 10, 20, 50, 100 })
PagerVisibleNumericButtonCount=10
ColumnResizeMode=GridColumnResizeMode.ColumnsContainer
SelectionMode=GridSelectionMode.Single
AllowSelectRowByClick=true
SelectedDataItemChanged=@((object selected) => ViewForm(selected))
>

    <Columns>
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Status)" Caption="Expedite Status" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.InProgress)" Caption="In Progress" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.CreatedBy)" Caption="Created By" MinWidth="170" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.CoNum)" Caption="Order Number" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.CoLine)" Caption="Line" MinWidth="70" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.CoRelease)" Caption="Release" MinWidth="70" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.PlanCode)" Caption="Planner Code" MinWidth="70" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.ShipSite)" Caption="Ship Site" MinWidth="70" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Job)" Caption="Job Number" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Ipn)" Caption="IPN" MinWidth="200" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.IpnDescription)" Caption="IPN Description" MinWidth="200" />

        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.OrderDate)" Caption="Order Date" MinWidth="100" DisplayFormat="d" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.CustomerName)" Caption="Customer Name" MinWidth="130" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.QtyOrdered)" Caption="Quantity" MinWidth="70" DisplayFormat="N0" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Um)" Caption="UOM" MinWidth="70" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.DueDate)" Caption="Due Date" MinWidth="70" DisplayFormat="d" />

        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.ShelfLifeRequirement)" Caption="Shelf Life Required" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.PonderosaPack)" Caption="Ponderosa Pack" MinWidth="70" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.CurrentDueDate)" Caption="Current Due Date" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.PartialQuantityAccepted)" Caption="Partial Accepted" MinWidth="100" />

        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.PartialQuantity)" Caption="Partial Quantity" MinWidth="70" DisplayFormat="N0" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.ShipDate)" Caption="Request Ship Date" MinWidth="100" DisplayFormat="d" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Fee)" Caption="Expedite Fee" MinWidth="70" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Reason)" Caption="Reason for Expedite" MinWidth="150" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Comments)" Caption="Comments" MinWidth="300" />

        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Approver)" Caption="Approver" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.ApprovalStatus)" Caption="Approve Status" MinWidth="100" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.ApprovalRemarks)" Caption="Approver Comments" MinWidth="150" /> 

        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.NewShipDate)" Caption="New Ship Date" MinWidth="90" DisplayFormat="d" />
        <DxGridDataColumn FieldName="@nameof(ExpediteRequestsExtended.Created)" SortIndex="0" SortOrder="GridColumnSortOrder.Descending" Caption="Created Date" MinWidth="90" DisplayFormat="g" />
    </Columns>

</DxGrid>



@code {
    private EntityInstantFeedbackSource _instantFeedbackSource = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _instantFeedbackSource = new(options =>
            {
                options.KeyExpression = nameof(ExpediteRequestsExtended.Id);
                options.QueryableSource = documentService.GetAll();
            });
        }
        catch(Exception ex)
        {
            logger.LogError(ex.ToString());
        }
    }

    private void ViewForm(object proxyObject)
    {
        var proxy = proxyObject as ReadonlyThreadSafeProxyForObjectFromAnotherThread;
        var row = proxy?.OriginalRow as ExpediteRequestsExtended;

        if (row is not null) navigationManager.NavigateTo($"ExpediteForm/{row.Gkey.ToString()}");
    }

    public void Dispose()
    {
        _instantFeedbackSource?.Dispose();
    }
}
