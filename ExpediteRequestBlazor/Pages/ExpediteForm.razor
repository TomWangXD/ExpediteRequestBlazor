@page "/ExpediteForm"
@page "/ExpediteForm/{Gkey}"

@using ExpediteRequestBlazor.Components
@using ExpediteRequestBlazor.Modules.Repositories.Interfaces
@using Indium.Common.Models
@using MudBlazor

@inject IDocumentService documentService
@inject IExpediteRequestService expediteRequestService
@inject ISnackbar snackbar
@inject ILogger<ExpediteForm> logger

<Form Data="document"/>

@code {

    [Parameter]
    public string? Gkey { get; set; }

    public Guid? ConvertedGkey { get; set; }

    private MudForm _form = default!;
    private Document document = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Gkey is not null)
        {
            ConvertedGkey = Guid.TryParse(Gkey, out var parsed) ? parsed : null;
            document = await documentService.Get(ConvertedGkey ?? Guid.NewGuid());
        }
    }


}
