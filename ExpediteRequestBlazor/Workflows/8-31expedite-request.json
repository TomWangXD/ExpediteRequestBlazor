    {
      "$id": "126",
      "activityId": "6cf8da18-a69c-4687-bc2b-193cf4d13d4f",
      "type": "SendHttpRequest",
      "displayName": "Send HTTP Request",
      "persistWorkflow": false,
      "loadWorkflowContext": false,
      "saveWorkflowContext": false,
      "properties": [
        {
          "$id": "127",
          "name": "Url",
          "syntax": "JavaScript",
          "expressions": {
            "$id": "128",
            "JavaScript": "return WFBody.EmailAPI"
          }
        },
        {
          "$id": "129",
          "name": "Method",
          "expressions": {
            "$id": "130",
            "Literal": "POST"
          }
        },
        {
          "$id": "131",
          "name": "Content",
          "syntax": "JavaScript",
          "expressions": {
            "$id": "132",
            "JavaScript": "Reaction = document.Status == \"Approve Total\" ? \"Approved (Total)\" : document.Status == \"Approve Partial\" ? \"Approved (Partial)\" : \"Approved\"\r\n\r\nassigned = WFBody.OrigninatorEmail\r\nEmailSubject = \"Expedite Request is \" + Reaction\r\nEmailSubject += document.CoNum ? \" \" +  document.CoNum : \"\"\r\nEmailSubject += document.CustomerName ? \" - \" + document.CustomerName : \"\"\r\n\r\nbody = \"<p>An entry you entered has been \" + Reaction + \".</p><ul>\"\r\nbody += \"<p><b>Order Information</b><br/>\"\r\nbody += document.CoNum ? \"<b>Order #: </b>\" + document.CoNum + \"<br/>\" : \"\"\r\nbody += document.CoLine != null ? \"<b>Line: </b>\" + document.CoLine + \"<br/>\" : \"\"\r\nbody += document.CoRelease != null ? \"<b>Release: </b>\" + document.CoRelease + \"<br/>\" : \"\"\r\nbody += document.CustomerName ? \"<b>Customer Name: </b>\" + document.CustomerName + \"<br/>\" : \"\"\r\nbody += document.IpnDescription ? \"<b>Description: </b><br />\" + document.IpnDescription + \"</p>\" : \"</p>\"\r\n\r\nbody += document.ShipDate ? \"<p><b>Ship Date: </b>\" + document.ShipDate.split(\"T\")[0] + \"<br/>\" : \"\"\r\nbody += document.NewShipDate ? \"<b>New Ship Date: </b>\" + document.NewShipDate.split(\"T\")[0] + \"<br/>\" : \"\"\r\nbody += document.Status ? \"<b>Expedite Status: </b>\" + document.Status + \"<br/>\" : \"\"\r\nbody += productionApproval.ApprovalStatus ? \"<b>Approver Status: </b>\" + productionApproval.ApprovalStatus + \"<br/>\" : \"\"\r\nbody += productionApproval.Remarks ? \"<b>Approver Comments: </b><br />\" + productionApproval.Remarks + \"</p>\" : \"</p>\"\r\n\r\n\r\nbody += \"</ul><p>To view the this entry in more detail, \"\r\nbody += \"<a href=\\\"https://\" + WFBody.AppLocation + \"/ExpediteRequest/Form/\" + document.Gkey + \"\\\">Click here to view entry</a></p>\"\r\n\r\nlet data = {\r\n    Recipients: assigned,\r\n    Subject:EmailSubject,\r\n    Body:body,\r\n    IsBodyHtml:true\r\n};\r\nreturn JSON.stringify(data);\r\n"
          }
        },
