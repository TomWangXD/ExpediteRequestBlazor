            "$id": "266",
            "JavaScript": "status = productionApproval?.ApprovalStatus;\r\n\r\nResponse = \"\";\r\nEmailSubject = \"\";\r\nbody = \"\";\r\n\r\n\r\nswitch (status) {\r\n    case 'Approve Total':\r\n\t\tResponse = \"Approved (Total)\"\r\n\t\tEmailSubject = \"Expedite Request is Approved (Total)\"\r\n\t\tbody = \"<p>An entry you entered has been Approved (Total).</p><ul>\"\r\n    case 'Approve Partial':\r\n\t\tResponse = \"Approved (Partial)\"\r\n\t\tEmailSubject = \"Expedite Request is Approved (Partial)\"\r\n\t\tbody = \"<p>An entry you entered has been Approved (Partial).</p><ul>\"\r\n    case 'Declined':\r\n        Response = \"Declined\"\r\n\t\tEmailSubject = \"Expedite Request is Declined\"\r\n\t\tbody = \"<p>An entry you entered has been Declined.</p><ul>\"\r\n    case 'Date Modified':\r\n        Response = \"Date Modified\"\r\n\t\tEmailSubject = \"Expedite Request has had the Date Modified\"\r\n\t\tbody = \"<p>An entry you entered has had the Date Modifed</p><ul>\"\r\n}\r\n\r\nassigned = WFBody.OrigninatorEmail\r\nEmailSubject += document.CoNum ? \" \" +  document.CoNum : \"\"\r\nEmailSubject += document.CustomerName ? \" - \" + document.CustomerName : \"\"\r\n\r\nbody += \"<p><b>Order Information</b>\"\r\nbody += document.CoNum ? \"<b>Order #: </b>\" + document.CoNum + \"<br/>\" : \"\"\r\nbody += document.CoLine != null ? \"<b>Line: </b>\" + document.CoLine + \"<br/>\" : \"\"\r\nbody += document.CoRelease != null ? \"<b>Release: </b>\" + document.CoRelease + \"<br/>\" : \"\"\r\nbody += document.CustomerName ? \"<b>Customer Name: </b>\" + document.CustomerName + \"<br/>\" : \"\"\r\nbody += document.IpnDescription ? \"<b>Description: </b><br />\" + document.IpnDescription + \"</p>\" : \"</p>\"\r\n\r\nbody += document.ShipDate ? \"<p><b>Ship Date: </b>\" + document.ShipDate.split(\"T\")[0] + \"<br/>\" : \"\"\r\nbody += document.NewShipDate ? \"<b>New Ship Date: </b>\" + document.NewShipDate.split(\"T\")[0] + \"<br/>\" : \"\"\r\nbody += document.Status ? \"<b>Expedite Status: </b>\" + document.Status + \"<br/>\" : \"\"\r\nbody += productionApproval.ApprovalStatus ? \"<b>Rejection Status: </b>\" + productionApproval.ApprovalStatus + \"<br/>\" : \"\"\r\nbody += productionApproval.Remarks ? \"<b>Rejection Comments: </b><br />\" + productionApproval.Remarks + \"</p>\" : \"</p>\"\r\n\r\n\r\nbody += \"</ul><p>To view the this entry in more detail, \"\r\nbody += \"<a href=\\\"https://\" + WFBody.AppLocation + \"/ExpediteRequest/Form/\" + document.Gkey + \"\\\">Click here to view entry</a></p>\"\r\n\r\nlet data = {\r\n    Recipients: assigned,\r\n    Subject:EmailSubject,\r\n    Body:body,\r\n    IsBodyHtml:true\r\n};\r\nreturn JSON.stringify(data);"
