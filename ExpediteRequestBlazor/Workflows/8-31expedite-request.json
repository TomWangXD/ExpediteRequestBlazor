          "$id": "77",
          "name": "Content",
          "syntax": "JavaScript",
          "expressions": {
            "$id": "78",
            "JavaScript": "status = productionApproval?.ApprovalStatus;\r\nStat = \"\"\r\nProgress= false\r\nswitch (status) {\r\n    case 'Approve Total':\r\n    case 'Approve Partial':\r\n    case 'Declined':\r\n        Stat = status\r\n        Progresss = false\r\n        break\r\n    case 'Date Modified':\r\n        amount = document?.NewShipType;\r\n        Stat = status + \" - \" + amount\r\n        Progress = false\r\n        break\r\n}\r\n\r\nreturn  {\r\n    ...document,\r\n    Status: Stat,\r\n    InProgress: Progress\r\n\r\n}"
          }
        },
