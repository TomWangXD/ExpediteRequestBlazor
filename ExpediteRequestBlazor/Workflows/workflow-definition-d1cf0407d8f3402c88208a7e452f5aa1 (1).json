          "syntax": "JavaScript",
          "expressions": {
            "$id": "68",
            "JavaScript": "var status = productionApproval?.ApprovalStatus;\r\n\r\nswitch (status) {\r\n    case 'Approve Total':\r\n    case 'Approve Partial':\r\n    case 'Declined':\r\n        document.Status = status\r\n        break\r\n    case 'Date Modified':\r\n        var amount = document?.NewShipType;\r\n        document.Status = status + \" - \" + amount\r\n        break\r\n}\r\n\r\nreturn document"
          }
        },
